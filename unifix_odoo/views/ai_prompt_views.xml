<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════ AI Prompt ═══════════════════ -->
    <record id="view_ai_prompt_list" model="ir.ui.view">
        <field name="name">unifix.ai.prompt.list</field>
        <field name="model">unifix.ai.prompt</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="view_ai_prompt_form" model="ir.ui.view">
        <field name="name">unifix.ai.prompt.form</field>
        <field name="model">unifix.ai.prompt</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reload_from_file" type="object"
                            string="Reload from File" class="btn-secondary"
                            confirm="Replace the current text with the vendored file default? This discards any edits."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="audio_extraction_v2"/></h1>
                    </div>
                    <group>
                        <field name="description" placeholder="What this prompt is for"/>
                        <field name="active"/>
                    </group>
                    <separator string="Template"/>
                    <field name="body" widget="text" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ai_prompt" model="ir.actions.act_window">
        <field name="name">AI Prompts</field>
        <field name="res_model">unifix.ai.prompt</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI prompts yet</p>
            <p>Prompts are seeded from the vendored files on install. Edit one to
               change extraction behaviour without touching the codebase.</p>
        </field>
    </record>

    <!-- ═══════════════════ AI Schema ═══════════════════ -->
    <record id="view_ai_schema_list" model="ir.ui.view">
        <field name="name">unifix.ai.schema.list</field>
        <field name="model">unifix.ai.schema</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="view_ai_schema_form" model="ir.ui.view">
        <field name="name">unifix.ai.schema.form</field>
        <field name="model">unifix.ai.schema</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reload_from_file" type="object"
                            string="Reload from File" class="btn-secondary"
                            confirm="Replace the current schema with the vendored file default? This discards any edits."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="v1"/></h1>
                    </div>
                    <group>
                        <field name="description" placeholder="Which document type this schema covers"/>
                        <field name="active"/>
                    </group>
                    <separator string="JSON Schema"/>
                    <field name="body" widget="ace" options="{'mode': 'json'}" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ai_schema" model="ir.actions.act_window">
        <field name="name">AI Schemas</field>
        <field name="res_model">unifix.ai.schema</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI schemas yet</p>
            <p>JSON schemas are seeded from the vendored files on install. They
               drive both the prompt's schema block and output validation.</p>
        </field>
    </record>

    <!-- ═══════════════════ Menus ═══════════════════ -->
    <menuitem id="menu_unifix_config" name="Configuration"
              parent="menu_workorder_root" sequence="90"
              groups="unifix_odoo.group_unifix_manager"/>
    <menuitem id="menu_ai_prompt" name="AI Prompts"
              parent="menu_unifix_config" action="action_ai_prompt" sequence="10"/>
    <menuitem id="menu_ai_schema" name="AI Schemas"
              parent="menu_unifix_config" action="action_ai_schema" sequence="20"/>
</odoo>
