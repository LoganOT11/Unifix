<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_form_inherit_unifix" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.unifix</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Unifix" data_string="unifix" name="unifix_video">
                    <block title="Gemini Configuration" name="gemini_config">
                        <setting string="Use Vertex AI (ADC)"
                                 help="Authenticate via Vertex AI + ADC (no API key)">
                            <field name="unifix_use_vertexai"/>
                        </setting>
                        <setting string="GCP Project"
                                 help="Vertex project (else GOOGLE_CLOUD_PROJECT)">
                            <field name="unifix_gcp_project"/>
                        </setting>
                        <setting string="GCP Location"
                                 help="Vertex location (else GOOGLE_CLOUD_LOCATION, default 'global')">
                            <field name="unifix_gcp_location"/>
                        </setting>
                        <setting string="API Key"
                                 help="Only used when Vertex AI is disabled">
                            <field name="unifix_gemini_api_key" password="True"/>
                        </setting>
                        <setting string="Model"
                                 help="Gemini model ID (e.g. gemini-2.5-pro, gemini-3.1-flash-lite)">
                            <field name="unifix_gemini_model"/>
                        </setting>
                    </block>
                    <block title="Field Validation" name="validation_config">
                        <setting string="Reference Data Source"
                                 help="Fixtures (out of the box) or live Odoo records">
                            <field name="unifix_reference_provider"/>
                        </setting>
                    </block>
                    <block title="Processing" name="processing_config">
                        <setting string="Max Video Size"
                                 help="Maximum upload size in MB">
                            <field name="unifix_max_video_size_mb"/>
                        </setting>
                        <setting string="Max Audio Size"
                                 help="Maximum audio upload size in MB">
                            <field name="unifix_max_audio_size_mb"/>
                        </setting>
                        <setting string="Max Image Size"
                                 help="Maximum image upload size in MB">
                            <field name="unifix_max_image_size_mb"/>
                        </setting>
                        <setting string="Temp Directory"
                                 help="Directory for temp video files (default: /tmp)">
                            <field name="unifix_temp_dir"/>
                        </setting>
                        <setting string="Cleanup Age"
                                 help="Hours before orphaned temp files are deleted">
                            <field name="unifix_cleanup_age_hours"/>
                        </setting>
                    </block>
                    <block title="Keyframes" name="keyframe_config">
                        <setting string="Max Frames"
                                 help="Max keyframes extracted per video">
                            <field name="unifix_max_keyframes"/>
                        </setting>
                        <setting string="Frame Quality"
                                 help="JPEG quality (2=best, 31=worst)">
                            <field name="unifix_frame_quality"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
