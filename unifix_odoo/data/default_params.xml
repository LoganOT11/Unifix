<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="default_gemini_model" model="ir.config_parameter">
            <field name="key">unifix.gemini_model</field>
            <field name="value">gemini-3.1-flash-lite</field>
        </record>
        <!-- Auth: this deployment uses Vertex AI with ADC (no API key).
             Project/location resolve from GOOGLE_CLOUD_PROJECT /
             GOOGLE_CLOUD_LOCATION env vars unless overridden via
             unifix.gcp_project / unifix.gcp_location params. -->
        <record id="default_use_vertexai" model="ir.config_parameter">
            <field name="key">unifix.use_vertexai</field>
            <field name="value">True</field>
        </record>
        <!-- Field validation source: 'memory' = bundled fixtures (works out of
             the box); 'odoo' = validate against live records via
             OdooReferenceDataProvider. Switch to 'odoo' once master data exists. -->
        <record id="default_reference_provider" model="ir.config_parameter">
            <field name="key">unifix.reference_provider</field>
            <field name="value">memory</field>
        </record>
        <record id="default_max_video_size" model="ir.config_parameter">
            <field name="key">unifix.max_video_size_mb</field>
            <field name="value">1024</field>
        </record>
        <record id="default_cleanup_age" model="ir.config_parameter">
            <field name="key">unifix.cleanup_age_hours</field>
            <field name="value">1</field>
        </record>
        <record id="default_max_keyframes" model="ir.config_parameter">
            <field name="key">unifix.max_keyframes</field>
            <field name="value">12</field>
        </record>
        <record id="default_frame_quality" model="ir.config_parameter">
            <field name="key">unifix.frame_quality</field>
            <field name="value">3</field>
        </record>
        <!-- Ingest compression: store small derivatives, not originals. -->
        <record id="default_audio_opus_bitrate" model="ir.config_parameter">
            <field name="key">unifix.audio_opus_bitrate</field>
            <field name="value">24k</field>
        </record>
        <record id="default_image_max_dim" model="ir.config_parameter">
            <field name="key">unifix.image_max_dim</field>
            <field name="value">2048</field>
        </record>
        <record id="default_image_jpeg_quality" model="ir.config_parameter">
            <field name="key">unifix.image_jpeg_quality</field>
            <field name="value">80</field>
        </record>
        <!-- Default video keyframe mode (per-job overridable):
             'audio_cues'   — cheapest, sharpest frame near each audio cue;
             'verified'     — adds one cheap image call so the AI confirms the
                              frame shows what was described (recommended);
             'gemini_video' — Gemini watches the whole video (duration-priced). -->
        <record id="default_video_keyframe_mode" model="ir.config_parameter">
            <field name="key">unifix.video_keyframe_mode</field>
            <field name="value">verified</field>
        </record>
        <!-- Blended $/million tokens used only for the UI cost estimate. -->
        <record id="default_token_price_per_million" model="ir.config_parameter">
            <field name="key">unifix.token_price_per_million</field>
            <field name="value">0.30</field>
        </record>
    </data>
</odoo>
