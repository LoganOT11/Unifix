<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_unifix">
        <field name="name">Unifix</field>
        <field name="sequence">90</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_unifix_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_unifix"/>
        <field name="comment">Can upload videos and view own jobs.</field>
    </record>

    <record id="group_unifix_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_unifix"/>
        <field name="implied_ids" eval="[(4, ref('group_unifix_user'))]"/>
        <field name="comment">Full access to all jobs, settings, and keyframes.</field>
        <!-- Make the administrator a Unifix Manager so the Configuration menu
             (AI Prompts / AI Schemas) is reachable out of the box. We assign
             from the group side because base.user_admin is a noupdate record,
             so writes targeting it from this module are skipped on upgrade. -->
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
